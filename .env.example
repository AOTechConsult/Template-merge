# ---- Where the app is reached. BASE_URL must match the redirect URI on the Entra app registration.
BASE_URL=https://csrt.corp.example.com:8443
SITE_ADDRESS=csrt.corp.example.com
HTTPS_PORT=8443
ORG_NAME=Kasasa

# ---- Try it first with sample documents (no Microsoft, AI or Confluence connection). Set to false for real use.
DEMO_MODE=true

# ---- Microsoft Entra sign-in (its own app registration; README, "Entra setup")
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional: only members of this group may sign in (needs the groups claim; README).
ENTRA_ALLOWED_GROUP_ID=

# ---- AI fallback. Set up either or both; leave blank to use heading matching only.
DEFAULT_AI_PROVIDER=glean
# Glean (search and answers via the Glean Client API). Base URL looks like https://<company>-be.glean.com
GLEAN_BASE_URL=
GLEAN_API_TOKEN=
# Optional: X-Glean-Auth-Type (e.g. OAUTH) and X-Scio-Actas (email, for global tokens)
GLEAN_AUTH_TYPE=
GLEAN_ACT_AS=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Confluence source pages. Cloud: base URL ending in /wiki, plus email and API token.
# Data Center/Server: the site URL plus a personal access token (CONFLUENCE_PAT) instead.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAT=

# ---- Optional
MAX_UPLOAD_MB=25
SESSION_HOURS=8
